{
  "name": "hiwar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "test": "bun test --pass-with-no-tests",
    "check": "biome check . && tsc -b && bun test --pass-with-no-tests && vite build",
    "deploy": "vite build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=.dev.vars x drizzle-kit migrate",
    "cf-typegen": "wrangler types --env-file .dev.vars.example",
    "postinstall": "wrangler types --env-file .dev.vars.example"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.20",
    "openai": "^7.62.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/vite-plugin": "^1.70.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
